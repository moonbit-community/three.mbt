// The MoonBit side of the A4 mock-GPU scenarios (harness/a4_scenarios.mjs): TSL agent A4's
// display add-ons rendered through a RenderPipeline.
import {
  "moonbit-community/three/core",
  "moonbit-community/three/geometries",
  "moonbit-community/three/math",
  "moonbit-community/three/nodes",
  "moonbit-community/three/renderers/webgpu",
  "moonbit-community/three/addons/tsl",
}

warnings = "-1-2-3-6-7-9-20-28-29-35-79"

options(
  "is-main": true,
  link: {
    "js": {
      "exports": [ "scenario_names", "run_scenario" ],
      "format": "esm",
    },
  },
)
