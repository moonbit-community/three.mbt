// Type aliases

// Traits
pub(open) trait GLData {
  fn to_gl_data(Self) -> @core.JsValue
}
pub impl[T : GLData] GLData for T?
pub impl[T] GLData for FixedArray[T]
pub impl GLData for @core.JsValue
pub impl GLData for @core.TypedArray
pub impl[T] GLData for Array[T]

pub(open) trait LightProbeGridSource {
  fn texture(Self) -> @core.Texture?
  fn bounding_box(Self) -> @math.Box3
  fn resolution(Self) -> @math.Vector3
  fn priority(Self) -> Double
}

pub(open) trait SunLightShadowSource {
  fn get_matrix(Self, Int32) -> @math.Matrix4
  fn cascade_data(Self, Int32) -> @core.UniformValue
  fn get_camera(Self, @core.LightShadow, Int32) -> @core.Object3D = _
  fn get_frustum(Self, @core.LightShadow, Int32) -> @math.Frustum = _
  fn get_viewport(Self, @core.LightShadow, Int32) -> @math.Vector4 = _
  fn update_matrices(Self, @core.LightShadow, @core.Object3D, @core.Object3D) -> Unit = _
}

pub(open) trait WebGLNodesHandler {
  fn set_renderer(Self, WebGLRenderer) -> Unit
  fn set_object(Self, @core.Object3D, @core.Material) -> Unit
  fn render_start(Self, @core.Object3D, @core.Object3D, @core.Object3D?) -> Unit
  fn render_end(Self) -> Unit
  fn update_lights(Self, Array[@core.Object3D]) -> Unit
  fn build(Self, @core.Material, @core.Object3D, WebGLProgramParameters) -> Unit
  fn on_update_program(Self, @core.Material, WebGLProgram, MaterialProperties) -> Unit
}

pub(open) trait WebGLOutputEffect {
  fn render(Self, WebGLRenderer, @core.RenderTarget?, @core.RenderTarget, Double?) -> Unit
  fn enabled(Self) -> Bool = _
  fn needs_swap(Self) -> Bool = _
  fn is_render_pass(Self) -> Bool = _
  fn is_output_pass(Self) -> Bool = _
  fn needs_depth_texture(Self) -> Bool = _
  fn set_size(Self, Int32, Int32) -> Unit = _
  fn set_depth_texture(Self, @core.Texture) -> Unit = _
}
