  extension : GLExtension,
  mode : Int32,
  counts : @core.JsValue,
  counts_offset : Int32,
  type_ : Int32,
  offsets : @core.JsValue,
  offsets_offset : Int32,
  drawcount : Int32,
) -> Unit = "(o, a0, a1, a2, a3, a4, a5, a6) => o.multiDrawElementsWEBGL(a0, a1, a2, a3, a4, a5, a6)"

///|
/// `extension.multiDrawElementsWEBGL( mode, counts, counts_offset, type_, offsets, offsets_offset, drawcount )`.
pub fn[D0 : GLData, D1 : GLData] GLExtension::multi_draw_elements_webgl(
  self : GLExtension,
  mode : Int32,
  counts : D0,
  counts_offset : Int32,
  type_ : Int32,
  offsets : D1,
  offsets_offset : Int32,
  drawcount : Int32,
) -> Unit {
  ffi_ext_multi_draw_elements_webgl(
    self,
    mode,
    counts.to_gl_data(),
    counts_offset,
    type_,
    offsets.to_gl_data(),
    offsets_offset,
    drawcount,
  )
}

