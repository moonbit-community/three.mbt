///|
extern "js" fn ffi_ext_framebuffer_texture2d_multisample_ext(
  extension : GLExtension,
  target : Int32,
  attachment : Int32,
  textarget : Int32,
  texture : @core.JsValue,
  level : Int32,
  samples : Int32,
) -> Unit = "(o, a0, a1, a2, a3, a4, a5) => o.framebufferTexture2DMultisampleEXT(a0, a1, a2, a3, a4, a5)"

///|
/// `extension.framebufferTexture2DMultisampleEXT( target, attachment, textarget, texture, level, samples )`.
pub fn GLExtension::framebuffer_texture2d_multisample_ext(
  self : GLExtension,
  target : Int32,
  attachment : Int32,
  textarget : Int32,
  texture : GLTexture?,
  level : Int32,
  samples : Int32,
) -> Unit {
  ffi_ext_framebuffer_texture2d_multisample_ext(
    self,
    target,
    attachment,
    textarget,
    gl_nullable(texture),
    level,
    samples,
  )
}

