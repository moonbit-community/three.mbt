// Type aliases

// Traits
pub(open) trait BufferAttributeLike {
  fn get_x(Self, Int32) -> Double
  fn get_y(Self, Int32) -> Double
  fn get_z(Self, Int32) -> Double
  fn get_w(Self, Int32) -> Double
}

pub(open) trait CameraMatrices {
  fn matrix_world(Self) -> Matrix4
  fn matrix_world_inverse(Self) -> Matrix4
  fn projection_matrix(Self) -> Matrix4
  fn projection_matrix_inverse(Self) -> Matrix4
}

pub(open) trait Interpolatable {
  fn set_scalar(Self, Double) -> Self
  fn add_scaled_vector(Self, Self, Double) -> Self
}
