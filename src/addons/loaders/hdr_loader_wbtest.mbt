// Tests parse tiny RGBE files (flat and run-length encoded) against upstream's values.

///|
fn hdr_test_buffer(bytes : Array[Int32]) -> @core.JsValue {
  @core.JsValue::of(@core.TypedArray::uint8(bytes).buffer())
}

///|
extern "js" fn hdr_test_try(f : () -> Unit) -> String = "(f) => { try { f(); return 'ok'; } catch (e) { return e.name + ': ' + e.message; } }"

///|
extern "js" fn hdr_test_get(o : @core.JsValue, k : String) -> @core.JsValue = "(o, k) => o[k]"

///|
let hdr_test_flat : Array[Int32] = [
  35, 63, 82, 65, 68, 73, 65, 78, 67, 69, 10, 70, 79, 82, 77, 65, 84, 61, 51, 50,
  45, 98, 105, 116, 95, 114, 108, 101, 95, 114, 103, 98, 101, 10, 71, 65, 77, 77,
  65, 61, 50, 46, 50, 10, 10, 45, 89, 32, 50, 32, 43, 88, 32, 56, 10, 0, 255, 0,
  120, 10, 254, 3, 121, 20, 253, 6, 122, 30, 252, 9, 123, 40, 251, 12, 124, 50, 250,
  15, 125, 60, 249, 18, 126, 70, 248, 21, 127, 80, 247, 24, 128, 90, 246, 27, 129,
  100, 245, 30, 130, 110, 244, 33, 131, 120, 243, 36, 132, 130, 242, 39, 133, 140,
  241, 42, 134, 150, 240, 45, 135,
]

///|
let hdr_test_rle : Array[Int32] = [
  35, 63, 82, 71, 66, 69, 10, 70, 79, 82, 77, 65, 84, 61, 51, 50, 45, 98, 105, 116,
  95, 114, 108, 101, 95, 114, 103, 98, 101, 10, 10, 45, 89, 32, 49, 32, 43, 88, 32,
  56, 10, 2, 2, 0, 8, 136, 50, 4, 1, 2, 3, 4, 132, 9, 8, 0, 1, 2, 3, 4, 5, 6, 7,
  136, 130,
]

///|
test "HDRLoader parses flat RGBE as upstream" {
  let half = HDRLoader::new().parse(hdr_test_buffer(hdr_test_flat))
  assert_eq(half.width, Some(8))
  assert_eq(half.height, Some(2))
  assert_eq(half.type_, Some(@core.HalfFloatType))
  assert_eq(half.flip_y, Some(true))
  assert_eq(half.data.unwrap().to_array(), [
    0.0, 7168.0, 0.0, 15360.0, 3333.0, 8183.0, 1542.0, 15360.0, 5381.0, 9199.0, 3590.0,
    15360.0, 7047.0, 10215.0, 5252.0, 15360.0, 8453.0, 11231.0, 6662.0, 15360.0,
    9798.0, 12247.0, 8071.0, 15360.0, 11143.0, 13263.0, 9348.0, 15360.0, 12388.0,
    14279.0, 10565.0, 15360.0, 13573.0, 15295.0, 11782.0, 15360.0, 14757.0, 16311.0,
    12998.0, 15360.0, 15942.0, 17327.0, 14215.0, 15360.0, 17126.0, 18343.0, 15396.0,
    15360.0, 18311.0, 19359.0, 16516.0, 15360.0, 19476.0, 20375.0, 17636.0, 15360.0,
    20580.0, 21391.0, 18757.0, 15360.0, 21684.0, 22407.0, 19877.0, 15360.0,
  ])
  let extra = half.extra.unwrap()
  assert_eq(hdr_test_get(extra, "gamma").cast(), 2.2)
  assert_eq(
    hdr_test_get(extra, "header").cast(),
    "#?RADIANCE\nFORMAT=32-bit_rle_rgbe\nGAMMA=2.2\n\n-Y 2 +X 8\n",
  )
  let float = HDRLoader::new()
    .set_data_type(@core.FloatType)
    .parse(hdr_test_buffer(hdr_test_flat))
  assert_eq(float.data.unwrap().to_array(), [
    0.0, 0.00390625, 0.0, 1.0, 0.00030637255986221135, 0.007781862746924162, 9.191176650347188e-05,
    1.0, 0.0012254902394488454, 0.015502450987696648, 0.0003676470660138875, 1.0,
    0.0036764706019312143, 0.030882352963089943, 0.001102941227145493, 1.0, 0.009803921915590763,
    0.06151960790157318, 0.0029411765281111, 1.0, 0.02450980432331562, 0.12254901975393295,
    0.007352941203862429, 1.0, 0.05882352963089943, 0.2441176474094391, 0.01764705963432789,
    1.0, 0.13725490868091583, 0.48627451062202454, 0.04117647185921669, 1.0, 0.3137255012989044,
    0.9686274528503418, 0.0941176488995552, 1.0, 0.7058823704719543, 1.929411768913269,
    0.21176470816135406, 1.0, 1.5686274766921997, 3.843137264251709, 0.47058823704719543,
    1.0, 3.4509804248809814, 7.65490198135376, 1.0352941751480103, 1.0, 7.529411792755127,
    15.247058868408203, 2.2588236331939697, 1.0, 16.3137264251709, 30.368627548217773,
    4.894117832183838, 1.0, 35.13725662231445, 60.48627471923828, 10.541176795959473,
    1.0, 75.29412078857422, 120.47058868408203, 22.58823585510254, 1.0,
  ])
}

///|
test "HDRLoader decodes run-length scanlines as upstream" {
  let float = HDRLoader::new()
    .set_data_type(@core.FloatType)
    .parse(hdr_test_buffer(hdr_test_rle))
  assert_eq(float.data.unwrap().to_array(), [
    0.7843137383460999, 0.01568627543747425, 0.0, 1.0, 0.7843137383460999, 0.0313725508749485,
    0.01568627543747425, 1.0, 0.7843137383460999, 0.0470588244497776, 0.0313725508749485,
    1.0, 0.7843137383460999, 0.062745101749897, 0.0470588244497776, 1.0, 0.7843137383460999,
    0.1411764770746231, 0.062745101749897, 1.0, 0.7843137383460999, 0.1411764770746231,
    0.0784313753247261, 1.0, 0.7843137383460999, 0.1411764770746231, 0.0941176488995552,
    1.0, 0.7843137383460999, 0.1411764770746231, 0.10980392247438431, 1.0,
  ])
}

///|
test "HDRLoader throws upstream's errors" {
  assert_eq(
    hdr_test_try(() => ignore(HDRLoader::new().parse(hdr_test_buffer([])))),
    "Error: THREE.HDRLoader: Read Error: no header found",
  )
  assert_eq(
    hdr_test_try(() => {
      ignore(HDRLoader::new().parse(hdr_test_buffer([35, 33, 10, 10])))
    }),
    "Error: THREE.HDRLoader: Bad File Format: bad initial token",
  )
  assert_eq(
    hdr_test_try(() => {
      ignore(
        HDRLoader::new()
        .set_data_type(@core.UnsignedByteType)
        .parse(hdr_test_buffer(hdr_test_flat)),
      )
    }),
    "Error: THREE.HDRLoader: Unsupported type: 1009",
  )
}
