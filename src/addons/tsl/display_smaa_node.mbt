// examples/jsm/tsl/display/SMAANode.js

///|
/// The module's top-level `_quadMesh`.
priv struct SMAANodeModule {
  _quad_mesh : @nodes.QuadMesh
}

///|
let _smaa_node_size : @math.Vector2 = @math.Vector2::new(0.0, 0.0)

///|
let _smaa_node_renderer_state : Ref[@nodes.RendererState?] = Ref(None)

///|
let display_smaa_node_module : AddonModule[SMAANodeModule] = AddonModule::new(fn() {
  { _quad_mesh: @nodes.QuadMesh::new(), }
})

///|
/// Evaluates SMAANode.js (its `_quadMesh`), as `import` does.
pub fn load_display_smaa_node() -> Unit {
  display_smaa_node_module.get() |> ignore
}

///|
/// `new Image()` (an `HTMLImageElement`).
extern "js" fn smaa_node_new_image() -> @core.JsValue = "() => new Image()"

///|
/// `image.src = src`.
extern "js" fn smaa_node_set_image_src(
  image : @core.JsValue,
  src : String,
) -> Unit = "(image, src) => { image.src = src; }"

///|
/// `image.onload = function () { f() }`.
extern "js" fn smaa_node_set_image_onload(
  image : @core.JsValue,
  f : () -> Unit,
) -> Unit = "(image, f) => { image.onload = function () { f(); }; }"

///|
/// Post processing node for applying SMAA (subpixel morphological antialiasing).
pub(all) struct SMAANode {
  mut texture_node : @nodes.Node
  _render_target_edges : @core.RenderTarget
  _render_target_weights : @core.RenderTarget
  _render_target_blend : @core.RenderTarget
  _area_texture : @core.Texture
  _search_texture : @core.Texture
  _inv_size : @nodes.Node
  _area_texture_uniform : @nodes.Node
  _search_texture_uniform : @nodes.Node
  _edges_texture_uniform : @nodes.Node
  _weights_texture_uniform : @nodes.Node
  _material_edges : @core.Material
  _material_weights : @core.Material
  _material_blend : @core.Material
  _texture_node : @nodes.Node
}

///|
pub impl @nodes.NodeClass for SMAANode with fn class_name(_) {
  "SMAANode"
}

///|
pub impl @nodes.NodeClass for SMAANode with fn children(self, _, out) {
  @nodes.push_child(out, "textureNode", Some(self.texture_node))
}

///|
pub impl @nodes.NodeClass for SMAANode with fn set_size(self, _, width, height) {
  self.set_size(width, height)
  true
}

///|
pub impl @nodes.NodeClass for SMAANode with fn update_before(self, _, frame) {
  let renderer = frame.renderer.unwrap()
  let quad_mesh = display_smaa_node_module.get()._quad_mesh
  _smaa_node_renderer_state.val = Some(
    @nodes.reset_renderer_state(renderer, state?=_smaa_node_renderer_state.val),
  )
  //
  let size = renderer.get_drawing_buffer_size(_smaa_node_size)
  self.set_size(size.x, size.y)
  // edges
  renderer.set_render_target(Some(self._render_target_edges))
  quad_mesh.set_material(self._material_edges)
  quad_mesh.render(renderer)
  // weights
  renderer.set_render_target(Some(self._render_target_weights))
  quad_mesh.set_material(self._material_weights)
  quad_mesh.render(renderer)
  // blend
  renderer.set_render_target(Some(self._render_target_blend))
  quad_mesh.set_material(self._material_blend)
  quad_mesh.render(renderer)
  // restore
  @nodes.restore_renderer_state(
    renderer,
    _smaa_node_renderer_state.val.unwrap(),
  )
  None
}

///|
pub impl @nodes.NodeClass for SMAANode with fn setup(self, _, builder) {
  let smaa_threshold = 0.1
  let smaa_max_search_steps = 8
  let smaa_areatex_max_distance = 16
  let smaa_areatex_pixel_size = @nodes.vec2_of([1.0 / 160.0, 1.0 / 560.0])
  let smaa_areatex_subtex_size = 1.0 / 7.0
  let texture_node = self.texture_node
  let uv_node = match addon_texture_uv_node(texture_node) {
    Some(u) => u
    None => @nodes.uv()
  }
  let inv_size = self._inv_size
  // edges
  let smaa_edge_detection = @nodes.fn_(fn(_, _) {
    let v_offset0 = @nodes.vec4_of([uv_node.xy(), uv_node.xy()])
      .add(
        @nodes.vec4_of([inv_size.xy(), inv_size.xy()]).mul(
          @nodes.vec4_of([-1.0, 0.0, 0.0, -1.0]),
        ),
      )
      .to_vertex_stage()
    let v_offset1 = @nodes.vec4_of([uv_node.xy(), uv_node.xy()])
      .add(
        @nodes.vec4_of([inv_size.xy(), inv_size.xy()]).mul(
          @nodes.vec4_of([1.0, 0.0, 0.0, 1.0]),
        ),
      )
      .to_vertex_stage()
    let v_offset2 = @nodes.vec4_of([uv_node.xy(), uv_node.xy()])
      .add(
        @nodes.vec4_of([inv_size.xy(), inv_size.xy()]).mul(
          @nodes.vec4_of([-2.0, 0.0, 0.0, -2.0]),
        ),
      )
      .to_vertex_stage()
    let threshold = @nodes.vec2_of([smaa_threshold, smaa_threshold])
    // Calculate color deltas:
    let delta = @nodes.vec4_of([]).to_var()
    let c = self.texture_node.sample(uv_node).rgb().to_var()
    // Calculate left and top deltas:
    let cleft = self.texture_node.sample(v_offset0.xy()).rgb().to_var()
    let mut t = @nodes.abs(c.sub(cleft))
    delta.x().assign(@nodes.max_of([t.r(), t.g(), t.b()]))
    let ctop = self.texture_node.sample(v_offset0.zw()).rgb().to_var()
    t = @nodes.abs(c.sub(ctop))
    delta.y().assign(@nodes.max_of([t.r(), t.g(), t.b()]))
    // We do the usual threshold:
    let edges = @nodes.step(threshold, delta.xy()).to_var()
    // Then discard if there is no edge:
    @nodes.dot(edges, @nodes.vec2_of([1.0, 1.0])).equal(0).discard()
    // Calculate right and bottom deltas:
    let cright = self.texture_node.sample(v_offset1.xy()).rgb().to_var()
    t = @nodes.abs(c.sub(cright))
    delta.z().assign(@nodes.max_of([t.r(), t.g(), t.b()]))
    let cbottom = self.texture_node.sample(v_offset1.zw()).rgb().to_var()
    t = @nodes.abs(c.sub(cbottom))
    delta.w().assign(@nodes.max_of([t.r(), t.g(), t.b()]))
    // Calculate the maximum delta in the direct neighborhood:
    let mut max_delta = @nodes.max_of([
      delta.x(),
      delta.y(),
      delta.z(),
      delta.w(),
    ]).to_var()
    // Calculate left-left and top-top deltas:
    let cleftleft = self.texture_node.sample(v_offset2.xy()).rgb().to_var()
    t = @nodes.abs(c.sub(cleftleft))
    delta.z().assign(@nodes.max_of([t.r(), t.g(), t.b()]))
    let ctoptop = self.texture_node.sample(v_offset2.zw()).rgb().to_var()
    t = @nodes.abs(c.sub(ctoptop))
    delta.w().assign(@nodes.max_of([t.r(), t.g(), t.b()]))
    // Calculate the final maximum delta:
    max_delta = @nodes.max_of([max_delta, delta.z(), delta.w()])
    // Local contrast adaptation in action:
    edges
    .xy()
    .mul_assign(
      @nodes.vec2(@nodes.step(@nodes.float(0.5).mul(max_delta), delta.xy())),
    )
    Some(@nodes.vec4_of([edges, 0, 0]))
  })
  // weights
  let smaa_search_length = @nodes.fn_(fn(inputs, _) {
    let search_tex = addon_arg(inputs, 0)
    let e = addon_arg(inputs, 1)
    let bias = addon_arg(inputs, 2)
    let scale = addon_arg(inputs, 3)
    // Not required if searchTex accesses are set to point:
    // float2 SEARCH_TEX_PIXEL_SIZE = 1.0 / float2(66.0, 33.0);
    // e = float2(bias, 0.0) + 0.5 * SEARCH_TEX_PIXEL_SIZE + e * float2(scale, 1.0) * float2(64.0, 32.0) * SEARCH_TEX_PIXEL_SIZE;
    let coord = @nodes.vec2(e).to_var()
    coord.r().assign(bias.add(coord.r().mul(scale)))
    Some(@nodes.float(255).mul(search_tex.sample(coord)).r())
  })
  let smaa_area = @nodes.fn_(fn(inputs, _) {
    let area_tex = addon_arg(inputs, 0)
    let dist = addon_arg(inputs, 1)
    let e1 = addon_arg(inputs, 2)
    let e2 = addon_arg(inputs, 3)
    let offset = addon_arg(inputs, 4)
    // Rounding prevents precision errors of bilinear filtering:
    let mut texcoord = @nodes.float(smaa_areatex_max_distance)
      .mul(@nodes.float(4).mul(@nodes.vec2_of([e1, e2])).round())
      .add(dist)
    // We do a scale and bias for mapping to texel space:
    texcoord = smaa_areatex_pixel_size
      .mul(texcoord)
      .add(@nodes.float(0.5).mul(smaa_areatex_pixel_size))
    // Move to proper place, according to the subpixel offset:
    texcoord.y().add_assign(@nodes.float(smaa_areatex_subtex_size).mul(offset))
    Some(area_tex.sample(texcoord).rg())
  })
  let smaa_search_x_left = @nodes.fn_(fn(inputs, _) {
    let edges_tex = addon_arg(inputs, 0)
    let search_tex = addon_arg(inputs, 1)
    let texcoord = addon_arg(inputs, 2)
    let end = addon_arg(inputs, 3)
    let e = @nodes.vec2_of([0.0, 1.0]).to_var()
    let coord = @nodes.vec2(texcoord).to_var()
    @nodes.loop_(
      [
        @nodes.loop_range(
          start=@nodes.int(0),
          end=@nodes.int(smaa_max_search_steps),
          type_="int",
          condition="<",
        ),
      ],
      fn(_) { // port note: Changed while to for
        e.assign(edges_tex.sample(coord).rg())
        coord.sub_assign(@nodes.vec2_of([2, 0]).mul(inv_size))
        @nodes.if_(
          coord
          .x()
          .less_than_equal(end)
          .or(
            e
            .g()
            .less_than_equal(@nodes.float(0.8281))
            .or(e.r().not_equal(@nodes.float(0))),
          ),
          fn() { @nodes.break_() },
        )
        |> ignore
      },
    )
    // We correct the previous (-0.25, -0.125) offset we applied:
    coord.x().add_assign(@nodes.float(0.25).mul(inv_size.x()))
    // The searches are bias by 1, so adjust the coords accordingly:
    coord.x().add_assign(inv_size.x())
    // Disambiguate the length added by the last step:
    coord.x().add_assign(@nodes.float(2).mul(inv_size.x()))
    coord
    .x()
    .sub_assign(
      inv_size.x().mul(smaa_search_length.call([search_tex, e, 0, 0.5])),
    )
    Some(coord.x())
  })
  let smaa_search_x_right = @nodes.fn_(fn(inputs, _) {
    let edges_tex = addon_arg(inputs, 0)
    let search_tex = addon_arg(inputs, 1)
    let texcoord = addon_arg(inputs, 2)
    let end = addon_arg(inputs, 3)
    let e = @nodes.vec2_of([0.0, 1.0]).to_var()
    let coord = @nodes.vec2(texcoord).to_var()
    @nodes.loop_(
      [
        @nodes.loop_range(
          start=@nodes.int(0),
          end=@nodes.int(smaa_max_search_steps),
          type_="int",
          condition="<",
        ),
      ],
      fn(_) { // port note: Changed while to for
        e.assign(edges_tex.sample(coord).rg())
        coord.add_assign(@nodes.vec2_of([2, 0]).mul(inv_size))
        @nodes.if_(
          coord
          .x()
          .greater_than_equal(end)
          .or(
            e
            .g()
            .less_than_equal(@nodes.float(0.8281))
            .or(e.r().not_equal(@nodes.float(0))),
          ),
          fn() { @nodes.break_() },
        )
        |> ignore
      },
    )
    coord.x().sub_assign(@nodes.float(0.25).mul(inv_size.x()))
    coord.x().sub_assign(inv_size.x())
    coord.x().sub_assign(@nodes.float(2).mul(inv_size.x()))
    coord
    .x()
    .add_assign(
      inv_size.x().mul(smaa_search_length.call([search_tex, e, 0.5, 0.5])),
    )
    Some(coord.x())
  })
  let smaa_search_y_up = @nodes.fn_(fn(inputs, _) {
    let edges_tex = addon_arg(inputs, 0)
    let search_tex = addon_arg(inputs, 1)
    let texcoord = addon_arg(inputs, 2)
    let end = addon_arg(inputs, 3)
    let e = @nodes.vec2_of([1.0, 0.0]).to_var()
    let coord = @nodes.vec2(texcoord).to_var()
    @nodes.loop_(
      [
        @nodes.loop_range(
          start=@nodes.int(0),
          end=@nodes.int(smaa_max_search_steps),
          type_="int",
          condition="<",
        ),
      ],
      fn(_) { // port note: Changed while to for
        e.assign(edges_tex.sample(coord).rg())
        coord.add_assign(@nodes.vec2_of([0, -2]).mul(inv_size))
        @nodes.if_(
          coord
          .y()
          .less_than_equal(end)
          .or(
            e
            .r()
            .less_than_equal(@nodes.float(0.8281))
            .or(e.g().not_equal(@nodes.float(0))),
          ),
          fn() { @nodes.break_() },
        )
        |> ignore
      },
    )
    coord.y().add_assign(@nodes.float(0.25).mul(inv_size.y()))
    coord.y().add_assign(inv_size.y())
    coord.y().add_assign(@nodes.float(2).mul(inv_size.y()))
    coord
    .y()
    .sub_assign(
      inv_size.y().mul(smaa_search_length.call([search_tex, e.gr(), 0, 0.5])),
    )
    Some(coord.y())
  })
  let smaa_search_y_down = @nodes.fn_(fn(inputs, _) {
    let edges_tex = addon_arg(inputs, 0)
    let search_tex = addon_arg(inputs, 1)
    let texcoord = addon_arg(inputs, 2)
    let end = addon_arg(inputs, 3)
    let e = @nodes.vec2_of([1.0, 0.0]).to_var()
    let coord = @nodes.vec2(texcoord).to_var()
    @nodes.loop_(
      [
        @nodes.loop_range(
          start=@nodes.int(0),
          end=@nodes.int(smaa_max_search_steps),
          type_="int",
          condition="<",
        ),
      ],
      fn(_) { // port note: Changed while to for
        e.assign(edges_tex.sample(coord).rg())
        coord.sub_assign(@nodes.vec2_of([0, -2]).mul(inv_size))
        @nodes.if_(
          coord
          .y()
          .greater_than_equal(end)
          .or(
            e
            .r()
            .less_than_equal(@nodes.float(0.8281))
            .or(e.g().not_equal(@nodes.float(0))),
          ),
          fn() { @nodes.break_() },
        )
        |> ignore
      },
    )
    coord.y().sub_assign(@nodes.float(0.25).mul(inv_size.y()))
    coord.y().sub_assign(inv_size.y())
    coord.y().sub_assign(@nodes.float(2).mul(inv_size.y()))
    coord
    .y()
    .add_assign(
      inv_size.y().mul(smaa_search_length.call([search_tex, e.gr(), 0.5, 0.5])),
    )
    Some(coord.y())
  })
  let smaa_weights = @nodes.fn_(fn(_, _) {
    let v_pixcoord = uv_node.xy().div(inv_size).to_vertex_stage()
    // We will use these offsets for the searches later on (see @PSEUDO_GATHER4):
    let v_offset0 = @nodes.vec4_of([uv_node.xy(), uv_node.xy()])
      .add(
        @nodes.vec4_of([inv_size.xy(), inv_size.xy()]).mul(
          @nodes.vec4_of([-0.25, -0.125, 1.25, -0.125]),
        ),
      )
      .to_vertex_stage()
    let v_offset1 = @nodes.vec4_of([uv_node.xy(), uv_node.xy()])
      .add(
        @nodes.vec4_of([inv_size.xy(), inv_size.xy()]).mul(
          @nodes.vec4_of([-0.125, -0.25, -0.125, 1.25]),
        ),
      )
      .to_vertex_stage()
    // And these for the searches, they indicate the ends of the loops:
    let v_offset2 = @nodes.vec4_of([v_offset0.xz(), v_offset1.yw()])
      .add(
        @nodes.vec4_of([-2.0, 2.0, -2.0, 2.0])
        .mul(@nodes.vec4_of([inv_size.xx(), inv_size.yy()]))
        .mul(@nodes.float(smaa_max_search_steps)),
      )
      .to_vertex_stage()
    let weights = @nodes.vec4_of([0.0, 0.0, 0.0, 0.0]).to_var()
    let subsample_indices = @nodes.vec4_of([0.0, 0.0, 0.0, 0.0]).to_var()
    let e = self._edges_texture_uniform.sample(uv_node).rg().to_var()
    @nodes.if_(e.g().greater_than(@nodes.float(0)), fn() { // Edge at north
      let mut d = @nodes.vec2_of([]).to_var()
      // Find the distance to the left:
      let coords_left = @nodes.vec2_of([]).to_var()
      coords_left
      .x()
      .assign(
        smaa_search_x_left.call([
          self._edges_texture_uniform,
          self._search_texture_uniform,
          v_offset0.xy(),
          v_offset2.x(),
        ]),
      )
      coords_left.y().assign(v_offset1.y()) // offset[1].y = texcoord.y - 0.25 * resolution.y (@CROSSING_OFFSET)
      d.x().assign(coords_left.x())
      // Now fetch the left crossing edges, two at a time using bilinear
      // filtering. Sampling at -0.25 (see @CROSSING_OFFSET) enables to
      // discern what value each edge has:
      let e1 = self._edges_texture_uniform.sample(coords_left).r().to_var()
      // Find the distance to the right:
      let coords_right = @nodes.vec2_of([]).to_var()
      coords_right
      .x()
      .assign(
        smaa_search_x_right.call([
          self._edges_texture_uniform,
          self._search_texture_uniform,
          v_offset0.zw(),
          v_offset2.y(),
        ]),
      )
      coords_right.y().assign(v_offset1.y())
      d.y().assign(coords_right.x())
      // We want the distances to be in pixel units (doing this here allow to
      // better interleave arithmetic and memory accesses):
      d = d.div(inv_size.x()).sub(v_pixcoord.x())
      // SMAAArea below needs a sqrt, as the areas texture is compressed quadratically:
      let sqrt_d = @nodes.sqrt(@nodes.abs(d))
      // Fetch the right crossing edges:
      let e2 = self._edges_texture_uniform
        .sample(coords_right.add(@nodes.vec2_of([1, 0]).mul(inv_size)))
        .r()
        .to_var()
      weights.r().assign(e2)
      // Get the area for this direction:
      weights
      .rg()
      .assign(
        smaa_area.call([
          self._area_texture_uniform,
          sqrt_d,
          e1,
          e2,
          @nodes.float(subsample_indices.y()),
        ]),
      )
    })
    |> ignore
    @nodes.if_(e.r().greater_than(@nodes.float(0)), fn() { // Edge at west
      let mut d = @nodes.vec2_of([]).to_var()
      // Find the distance to the top:
      let coords_up = @nodes.vec2_of([]).to_var()
      coords_up
      .y()
      .assign(
        smaa_search_y_up.call([
          self._edges_texture_uniform,
          self._search_texture_uniform,
          v_offset1.xy(),
          v_offset2.z(),
        ]),
      )
      coords_up.x().assign(v_offset0.x()) // offset[1].x = texcoord.x - 0.25 * resolution.x;
      d.x().assign(coords_up.y())
      // Fetch the top crossing edges:
      let e1 = self._edges_texture_uniform.sample(coords_up).g().to_var()
      // Find the distance to the bottom:
      let coords_down = @nodes.vec2_of([]).to_var()
      coords_down
      .y()
      .assign(
        smaa_search_y_down.call([
          self._edges_texture_uniform,
          self._search_texture_uniform,
          v_offset1.zw(),
          v_offset2.w(),
        ]),
      )
      coords_down.x().assign(v_offset0.x())
      d.y().assign(coords_down.y())
      // We want the distances to be in pixel units:
      d = d.div(inv_size.y()).sub(v_pixcoord.y())
      // SMAAArea below needs a sqrt, as the areas texture is compressed quadratically:
      let sqrt_d = @nodes.sqrt(@nodes.abs(d))
      // Fetch the bottom crossing edges:
      let e2 = self._edges_texture_uniform
        .sample(coords_down.add(@nodes.vec2_of([0, 1]).mul(inv_size)))
        .g()
        .to_var()
      // Get the area for this direction:
      weights
      .ba()
      .assign(
        smaa_area.call([
          self._area_texture_uniform,
          sqrt_d,
          e1,
          e2,
          @nodes.float(subsample_indices.x()),
        ]),
      )
    })
    |> ignore
    Some(weights)
  })
  // blend
  let smaa_blend = @nodes.fn_(fn(_, _) {
    let v_offset1 = @nodes.vec4_of([uv_node.xy(), uv_node.xy()])
      .add(
        @nodes.vec4_of([inv_size.xy(), inv_size.xy()]).mul(
          @nodes.vec4_of([1.0, 0.0, 0.0, 1.0]),
        ),
      )
      .to_vertex_stage()
    let result = @nodes.vec4_of([]).to_var()
    // Fetch the blending weights for current pixel:
    let a = @nodes.vec4_of([]).to_var()
    a.xz().assign(self._weights_texture_uniform.sample(uv_node).xz())
    a.y().assign(self._weights_texture_uniform.sample(v_offset1.zw()).g())
    a.w().assign(self._weights_texture_uniform.sample(v_offset1.xy()).a())
    // Is there any blending weight with a value greater than 0.0?
    @nodes.if_(@nodes.dot(a, @nodes.vec4(1.0)).less_than(0.00001), fn() { // Edge at north
      result.assign(self.texture_node.sample(uv_node))
    }).else_(fn() {
      // Up to 4 lines can be crossing a pixel (one through each edge). We
      // favor blending by choosing the line with the maximum weight for each
      // direction:
      let offset = @nodes.vec2_of([]).to_var()
      offset
      .x()
      .assign(a.a().greater_than(a.b()).select(a.a(), else_node=a.b().negate())) // left vs. right
      offset
      .y()
      .assign(a.g().greater_than(a.r()).select(a.g(), else_node=a.r().negate())) // top vs. bottom
      // Then we go in the direction that has the maximum weight:
      @nodes.if_(@nodes.abs(offset.x()).greater_than(@nodes.abs(offset.y())), fn() { // horizontal vs. vertical
        offset.y().assign(0)
      }).else_(fn() { offset.x().assign(0) })
      // Fetch the opposite color and lerp by hand:
      let c = self.texture_node.sample(uv_node).to_var()
      let texcoord = @nodes.vec2(uv_node).to_var()
      texcoord.add_assign(@nodes.sign(offset).mul(inv_size))
      let cop = self.texture_node.sample(texcoord).to_var()
      let s = @nodes.abs(offset.x())
        .greater_than(@nodes.abs(offset.y()))
        .select(@nodes.abs(offset.x()), else_node=@nodes.abs(offset.y()))
        .to_var()
      let mixed = @nodes.mix(c, cop, s)
      result.assign(mixed)
    })
    Some(result)
  })
  let shared_context = @nodes.context(value=builder.get_shared_context())
  let edges = @nodes.NodeMaterial::of(self._material_edges).unwrap()
  edges.context_node = Some(shared_context)
  edges.fragment_node = Some(smaa_edge_detection.call([]))
  self._material_edges.set_needs_update(true)
  let weights = @nodes.NodeMaterial::of(self._material_weights).unwrap()
  weights.context_node = Some(shared_context)
  weights.fragment_node = Some(smaa_weights.call([]))
  self._material_weights.set_needs_update(true)
  let blend = @nodes.NodeMaterial::of(self._material_blend).unwrap()
  blend.context_node = Some(shared_context)
  blend.fragment_node = Some(smaa_blend.call([]))
  self._material_blend.set_needs_update(true)
  Some(self._texture_node)
}

///|
pub impl @nodes.NodeClass for SMAANode with fn dispose(self, node) {
  node.dispose_base()
  self._render_target_edges.dispose()
  self._render_target_weights.dispose()
  self._render_target_blend.dispose()
  self._area_texture.dispose()
  self._search_texture.dispose()
  self._material_edges.dispose()
  self._material_weights.dispose()
  self._material_blend.dispose()
}

///|
/// `getTextureNode()`: the antialiased result.
pub fn SMAANode::get_texture_node(self : SMAANode) -> @nodes.Node {
  self._texture_node
}

///|
/// `setSize( width, height )`.
pub fn SMAANode::set_size(
  self : SMAANode,
  width : Double,
  height : Double,
) -> Unit {
  smaa_node_uniform_vector2(self._inv_size).set(1.0 / width, 1.0 / height)
  |> ignore
  self._render_target_edges.set_size(width.to_int(), height.to_int())
  self._render_target_weights.set_size(width.to_int(), height.to_int())
  self._render_target_blend.set_size(width.to_int(), height.to_int())
}

///|
fn smaa_node_uniform_vector2(node : @nodes.Node) -> @math.Vector2 {
  match @nodes.InputNode::get_value(node) {
    Vector2(v) => v
    _ => abort("uniform value is not a Vector2")
  }
}

///|
/// `new SMAANode( textureNode )`.
pub fn SMAANode::new(texture_node : @nodes.Node) -> @nodes.Node {
  display_smaa_node_module.get() |> ignore
  let node = @nodes.Node::alloc(node_type="vec4")
  node.update_before_type = @nodes.NodeUpdateType::frame()
  let render_target_edges = @core.RenderTarget::new(
    width=1,
    height=1,
    depth_buffer=false,
    type_=@core.HalfFloatType,
  )
  render_target_edges.texture().name = "SMAANode.edges"
  let render_target_weights = @core.RenderTarget::new(
    width=1,
    height=1,
    depth_buffer=false,
    type_=@core.HalfFloatType,
  )
  render_target_weights.texture().name = "SMAANode.weights"
  let render_target_blend = @core.RenderTarget::new(
    width=1,
    height=1,
    depth_buffer=false,
    type_=@core.HalfFloatType,
  )
  render_target_blend.texture().name = "SMAANode.blend"
  // textures
  let area_texture_ref : Ref[@core.Texture?] = Ref(None)
  let area_texture_image = smaa_node_new_image()
  smaa_node_set_image_src(area_texture_image, SMAANode::get_area_texture())
  smaa_node_set_image_onload(area_texture_image, fn() {
    // assigning data to HTMLImageElement.src is asynchronous (see #15162)
    area_texture_ref.val.unwrap().set_needs_update(true)
  })
  let area_texture = @core.Texture::new()
  area_texture_ref.val = Some(area_texture)
  area_texture.name = "SMAANode.area"
  area_texture.set_image(DomImage(area_texture_image))
  area_texture.min_filter = @core.LinearFilter
  area_texture.generate_mipmaps = false
  area_texture.flip_y = false
  let search_texture_ref : Ref[@core.Texture?] = Ref(None)
  let search_texture_image = smaa_node_new_image()
  smaa_node_set_image_src(search_texture_image, SMAANode::get_search_texture())
  smaa_node_set_image_onload(search_texture_image, fn() {
    // assigning data to HTMLImageElement.src is asynchronous (see #15162)
    search_texture_ref.val.unwrap().set_needs_update(true)
  })
  let search_texture = @core.Texture::new()
  search_texture_ref.val = Some(search_texture)
  search_texture.name = "SMAANode.search"
  search_texture.set_image(DomImage(search_texture_image))
  search_texture.mag_filter = @core.NearestFilter
  search_texture.min_filter = @core.NearestFilter
  search_texture.generate_mipmaps = false
  search_texture.flip_y = false
  let inv_size = @nodes.uniform(@math.Vector2::new(0.0, 0.0))
  let area_texture_uniform = @nodes.texture(area_texture)
  let search_texture_uniform = @nodes.texture(search_texture)
  let edges_texture_uniform = @nodes.texture(render_target_edges.texture())
  let weights_texture_uniform = @nodes.texture(render_target_weights.texture())
  let material_edges = @nodes.NodeMaterial::new()
  material_edges.name = "SMAANode.edges"
  let material_weights = @nodes.NodeMaterial::new()
  material_weights.name = "SMAANode.weights"
  let material_blend = @nodes.NodeMaterial::new()
  material_blend.name = "SMAANode.blend"
  let texture_node_out = @nodes.pass_texture(
    node,
    render_target_blend.texture(),
  )
  node.set_class(SMAANode::{
    texture_node,
    _render_target_edges: render_target_edges,
    _render_target_weights: render_target_weights,
    _render_target_blend: render_target_blend,
    _area_texture: area_texture,
    _search_texture: search_texture,
    _inv_size: inv_size,
    _area_texture_uniform: area_texture_uniform,
    _search_texture_uniform: search_texture_uniform,
    _edges_texture_uniform: edges_texture_uniform,
    _weights_texture_uniform: weights_texture_uniform,
    _material_edges: material_edges,
    _material_weights: material_weights,
    _material_blend: material_blend,
    _texture_node: texture_node_out,
  })
}

///|
pub fn SMAANode::of(node : @nodes.Node) -> SMAANode? {
  addon_class_of(node, "SMAANode")
}

///|
/// `smaa( node )`.
pub fn smaa(node : @nodes.Node) -> @nodes.Node {
  display_smaa_node_module.get() |> ignore
  SMAANode::new(@nodes.convert_to_texture(node))
}

///|
/// `_getAreaTexture()`: the area texture as a Base64 data URL.
fn SMAANode::get_area_texture() -> String {
  "data:image/png;base64,"
}

///|
/// `_getSearchTexture()`: the search texture as a Base64 data URL.
fn SMAANode::get_search_texture() -> String {
  "data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAAEIAAAAhCAAAAABIXyLAAAAAOElEQVRIx2NgGAWjYBSMglEwEICREYRgFBZBqDCSLA2MGPUIVQETE9iNUAqLR5gIeoQKRgwXjwAAGn4AtaFeYLEAAAAASUVORK5CYII="
}
