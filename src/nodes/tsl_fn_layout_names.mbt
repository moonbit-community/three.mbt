///|
/// How many `Fn`s `FnNode::set_layout` has named after each library key.
let tsl_fn_library_created : Map[String, Int32] = Map::from_array([])

///|
/// `(key, name, MoonBit file, created)` for every upstream library `Fn`. Top-level lets
/// are initialized at load, so `created` is 1 once the file is ported with `upstream=`.
pub fn tsl_fn_library_status() -> Array[(String, String, String, Int32)] {
  tsl_fn_library_keys.mapi(fn(i, key) {
    (
      key,
      "fn\{i}",
      tsl_fn_library_files[i],
      tsl_fn_library_created.get(key).unwrap_or(0),
    )
  })
}
