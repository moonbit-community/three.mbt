// nodes/accessors/StorageTextureNode.js: a storage texture, read (`textureLoad`) or
// written (`textureStore`) in compute shaders.

///|
pub(all) struct StorageTextureNode {
  texture : TextureNode
  mut store_node : Node?
  mut mip_level : Int32
  mut access : String
}

///|
pub impl NodeClass for StorageTextureNode with fn class_name(_) {
  "StorageTextureNode"
}

///|
pub impl NodeClass for StorageTextureNode with fn parent(self) {
  Some(self.texture)
}

///|
pub impl NodeClass for StorageTextureNode with fn has_flag(self, flag) {
  flag == "isStorageTextureNode" || self.texture.has_flag(flag)
}

///|
pub impl NodeClass for StorageTextureNode with fn children(self, node, out) {
  self.texture.children(node, out)
  push_child(out, "storeNode", self.store_node)
}

///|
pub impl NodeClass for StorageTextureNode with fn setup(self, node, builder) {
  self.texture.setup(node, builder) |> ignore
  let properties = builder.get_node_properties(node)
  properties.set_node_or_null("storeNode", self.store_node)
  // Upstream returns `properties`, which becomes the (non-node) output; the node is
  // generated by its own `generate`, so no output node is equivalent.
  None
}

///|
pub impl NodeClass for StorageTextureNode with fn generate(
  self,
  node,
  builder,
  output,
) {
  if self.store_node is Some(_) {
    StorageTextureNode::generate_store(node, builder)
    return Some("")
  }
  self.texture.generate(node, builder, output)
}

///|
pub impl InputNodeClass for StorageTextureNode with fn input_parent(self) {
  Some(self.texture)
}

///|
pub impl InputNodeClass for StorageTextureNode with fn get_input_type(_, _, _) {
  Some("storageTexture")
}

///|
pub impl TextureNodeClass for StorageTextureNode with fn texture_parent(self) {
  Some(self.texture)
}

///|
pub impl TextureNodeClass for StorageTextureNode with fn get_transformed_uv(
  _,
  _,
  uv_node,
) {
  uv_node
}

///|
pub impl TextureNodeClass for StorageTextureNode with fn generate_snippet(
  _,
  node,
  builder,
  texture_property,
  uv_snippet,
  level_snippet,
  _,
  depth_snippet,
  _,
  _,
  gather_snippet,
  _,
  _,
) {
  // Upstream's override lacks the `gatherSnippet` parameter, so its `offsetSnippet`
  // receives the gather snippet.
  builder.generate_storage_texture_load(
    TextureNode::get_value(node),
    texture_property,
    uv_snippet,
    level_snippet,
    depth_snippet,
    gather_snippet,
  )
}

///|
pub impl TextureNodeClass for StorageTextureNode with fn construct_like(
  _,
  value,
  uv_node,
  level_node,
  _,
) {
  // `new this.constructor( value, uvNode, levelNode, biasNode )`: the level lands in
  // `storeNode`, which `clone` then overwrites.
  StorageTextureNode::new(value, uv_node?, store_node?=level_node)
}

///|
pub impl TextureNodeClass for StorageTextureNode with fn clone(self, node) {
  let new_node = TextureNodeClass::clone(self.texture, node)
  let n = StorageTextureNode::of(new_node).unwrap()
  n.store_node = self.store_node
  n.mip_level = self.mip_level
  n.access = self.access
  new_node
}

///|
/// The constructor body.
pub fn StorageTextureNode::construct(
  node : Node,
  value : @core.Texture?,
  uv_node : Node?,
  store_node : Node?,
) -> StorageTextureNode {
  let texture = TextureNode::construct(node, value, uv_node, None, None)
  { texture, store_node, mip_level: 0, access: node_access_write_only, }
}

///|
/// `new StorageTextureNode( value, uvNode, storeNode = null )`.
pub fn StorageTextureNode::new(
  value : @core.Texture?,
  uv_node? : Node,
  store_node? : Node,
) -> Node {
  let node = Node::alloc()
  let s = StorageTextureNode::construct(node, value, uv_node, store_node)
  s.texture.install(node, s, s, s)
}

///|
pub fn StorageTextureNode::of(node : Node) -> StorageTextureNode? {
  match node.class_payload("StorageTextureNode") {
    Some(p) => Some(p.cast())
    None => None
  }
}

///|
fn storage_texture_node_payload(node : Node) -> StorageTextureNode {
  match StorageTextureNode::of(node) {
    Some(s) => s
    None => abort("TypeError: \{node.type_()} is not a StorageTextureNode")
  }
}

///|
/// `setMipLevel( level )`, chained.
pub fn Node::set_mip_level(self : Node, level : Int32) -> Node {
  storage_texture_node_payload(self).mip_level = level
  self
}

///|
/// `toReadWrite()`.
pub fn Node::to_read_write(self : Node) -> Node {
  self.set_access(node_access_read_write)
}

///|
/// `toWriteOnly()`.
pub fn Node::to_write_only(self : Node) -> Node {
  self.set_access(node_access_write_only)
}

///|
/// `store( uvNode, storeNode )`.
pub fn Node::store(self : Node, uv_node : Node, store_node : Node?) -> Node {
  let node = TextureNode::clone(self)
  let s = storage_texture_node_payload(node)
  s.texture.reference_node = Some(TextureNode::get_base(self))
  s.texture.uv_node = Some(uv_node)
  s.store_node = store_node
  if store_node is Some(_) {
    node.to_stack() |> ignore
  }
  node
}

///|
/// `generateStore( builder )`.
pub fn StorageTextureNode::generate_store(
  node : Node,
  builder : NodeBuilder,
) -> Unit {
  let s = storage_texture_node_payload(node)
  let properties = builder.get_node_properties(node)
  let uv_node = properties.get_node("uvNode").unwrap()
  let store_node = properties.get_node("storeNode").unwrap()
  let depth_node = properties.get_node("depthNode")
  // `super.generate( builder, 'property' )`: TextureNode's generate.
  let texture_property = s.texture
    .generate(node, builder, Some("property"))
    .unwrap_or("")
  let texture = TextureNode::get_value(node)
  let uv_snippet = uv_node.build(
    builder,
    output=if texture.has_extension_flag("is3DTexture") {
      "uvec3"
    } else {
      "uvec2"
    },
  )
  let store_type = builder.get_type_from_length(
    4,
    component_type=builder.get_component_type_from_texture(texture),
  )
  let store_snippet = store_node.build(builder, output=store_type)
  let depth_snippet = depth_node.map(fn(n) { n.build(builder, output="int") })
  let snippet = builder.generate_texture_store(
    texture, texture_property, uv_snippet, depth_snippet, store_snippet,
  )
  builder.add_line_flow_code(snippet, node~) |> ignore
}

///|
/// `storageTexture( value, uvNode, storeNode )`.
pub fn storage_texture(
  value : &IntoTsl,
  uv_node? : &IntoTsl,
  store_node? : &IntoTsl,
) -> Node {
  StorageTextureNode::new(
    texture_node_texture_arg(value.to_tsl()),
    uv_node?=texture_node_node_arg(texture_node_opt_arg(uv_node)),
    store_node?=texture_node_node_arg(texture_node_opt_arg(store_node)),
  )
}

///|
/// `textureStore( value, uvNode, storeNode )`.
pub fn texture_store(
  value : &IntoTsl,
  uv_node : &IntoTsl,
  store_node : &IntoTsl,
) -> Node {
  match value.to_tsl() {
    Node(v) if v.has_flag("isStorageTextureNode") =>
      v.store(
        node_object(uv_node.to_tsl()),
        Some(node_object(store_node.to_tsl())),
      )
    _ => {
      let node = storage_texture(value, uv_node~, store_node~)
      node.to_stack() |> ignore
      node
    }
  }
}
