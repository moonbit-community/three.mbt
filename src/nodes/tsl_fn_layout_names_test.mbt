// The `fn<id>` names of library `Fn`s (tsl_fn_layout_names.mbt, generated by
// tools/gen_fn_layout_names.mjs) and the user counter after them.

///|
fn g4_layout_name(f : @nodes.Node) -> String {
  @nodes.ShaderNodeInternal::of(@nodes.FnNode::of(f).unwrap().shader_node).unwrap().layout.unwrap().name
}

///|
fn g4_layout_number(f : @nodes.Node) -> Int32 {
  tsl_test_fn_number(g4_layout_name(f))
}

///|
fn g4_short_fn(upstream : String?) -> @nodes.Node {
  @nodes.fn_(
    fn(_, _) { None },
    layout=@nodes.FnLayout::short(
      [("color", "vec3")],
      return_="vec3",
      upstream?,
    ),
  )
}

///|
test "library Fns take upstream's names and leave the user counter alone" {
  let user1 = g4_short_fn(None)
  let library = g4_short_fn(
    Some("nodes/display/ToneMappingFunctions.js:RRTAndODTFit"),
  )
  let user2 = g4_short_fn(None)
  tsl_inspect(g4_layout_name(library), content="fn39")
  // the shader node keeps the return type of a short layout
  let shader = @nodes.ShaderNodeInternal::of(
    @nodes.FnNode::of(library).unwrap().shader_node,
  ).unwrap()
  tsl_inspect(shader.layout.unwrap().type_, content="Some(vec3)")
  tsl_inspect(
    @nodes.FnNode::of(library).unwrap().shader_node.node_type,
    content="Some(vec3)",
  )
  tsl_inspect(g4_layout_number(user2) - g4_layout_number(user1), content="1")
  // user functions count on from the 130 names upstream's library takes
  assert_true(g4_layout_number(user1) >= 130)
}

///|
test "the ported library Fns of nodes/display have their names" {
  let status = @nodes.tsl_fn_library_status()
  tsl_inspect(status.length(), content="130")
  let display = status.filter(fn(s) { s.0.has_prefix("nodes/display/") })
  tsl_inspect(display.length(), content="22")
  for s in display {
    assert_true(s.3 >= 1)
  }
  tsl_inspect(
    status[39],
    content=(
      #|(nodes/display/ToneMappingFunctions.js:RRTAndODTFit, fn39, display_tone_mapping_functions.mbt, 2)
    ),
  )
}
